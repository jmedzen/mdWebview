# mdWebview 帳號功能的環境變數範本。
# 複製成 .env（已列在 .gitignore，不會進版控）後填入；docker compose 會自動讀取。
# 寄信（MAIL_*）與 Turnstile（TURNSTILE_*）也可以不填，改在後台「🔑 帳號系統 → 開站設定」用網頁設定；
# 這裡有填的值優先，後台會顯示為鎖定。其他金鑰只放這裡，後台只會顯示「已設定／未設定」。

# 對外網址：驗證信、重設密碼連結與第三方登入回調都用它。沒設定時改用後台的「首頁權威 URL」。
PUBLIC_BASE_URL=https://example.org

# 第一次啟動建立管理員用的設定碼（不設定時每次啟動隨機產生並印在日誌）
ADMIN_SETUP_TOKEN=
# 舊版 config.json 管理員搬進帳號資料庫時使用的 Email（可留空，登入後再補）
ADMIN_EMAIL=

# 寄信：resend（正式）或 log（只寫進日誌，測試用）。這裡和後台都沒設定時，註冊與忘記密碼會暫停。
# 要在後台設定的話，三行都留空。
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=

# Cloudflare Turnstile 人機驗證（可不設；不設時只靠隱藏欄位與限速）
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 第三方登入：只有填齊的才會出現在登入畫面
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# 容器內 .p8 私鑰檔的路徑，例如把檔案放在 ./data/apple-auth.p8
APPLE_PRIVATE_KEY_PATH=

# Cookie 是否加 Secure：auto（預設，依 HTTPS 判斷）、true、false
COOKIE_SECURE=auto
# 帳號資料庫與備份位置（預設與 config.json 同目錄的 users.db、backups/）
USERS_DB_PATH=
DB_BACKUP_DIR=
