{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "mdWebview 桌面版所需的最小權限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-title",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/mdwebview-server",
          "sidecar": true
        }
      ]
    }
  ]
}
